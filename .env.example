# Copy to .env or .env.local — never commit real secrets.
# For Vercel: set the same keys in Project → Settings → Environment Variables.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Public origin used in OAuth discovery metadata and WWW-Authenticate
PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp

# ---------------------------------------------------------------------------
# Step 1 — PostgreSQL (required for Vercel; optional locally)
# ---------------------------------------------------------------------------
# 1. Create a Postgres DB (Neon / Vercel Postgres / Supabase).
# 2. Paste the connection string below (replace the placeholder).
# 3. Test with:
#      psql "$DATABASE_URL"
#    or:
#      psql "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# 4. Leave DATABASE_URL empty/commented to keep using SQLite locally.
#
# Neon example (paste your real URI inside quotes — & in the query must be quoted):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
#
DATABASE_URL=

ACCESS_TOKEN_EXPIRE_SECONDS=3600
AUTHORIZATION_CODE_EXPIRE_SECONDS=60
REFRESH_TOKEN_EXPIRE_SECONDS=86400

# Set true in production (Vercel) to reject tokens without RFC 8707 resource
MCP_REQUIRE_AUDIENCE=false
LOG_LEVEL=INFO

# Serverless: keep 0 on Vercel. Local Postgres can use 60.
DB_CONN_MAX_AGE=0
